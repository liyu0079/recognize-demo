{
  "name": "recognize-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "frontend:start": "vite --host 0.0.0.0",
    "backend:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/setup-backend.ps1",
    "backend:start": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/start-backend.ps1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
